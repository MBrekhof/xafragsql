  "cards": [
    {
      "dot": "cyan",
      "title": "Retrieval",
      "items": [
        "Question embedded to a 1536-dim float32 vector",
        "Chunks ranked by VECTOR_DISTANCE('cosine', ...)",
        "Matches under the distance threshold become context"
      ]
    },
    {
      "dot": "emerald",
      "title": "Storage",
      "items": [
        "Native SQL Server 2025 VECTOR(1536) column",
        "Exact kNN - scans every row, no vector index",
        "VECTOR_SEARCH and vector indexes are still experimental"
      ]
    },
    {
      "dot": "rose",
      "title": "Two DbContexts, one database",
      "items": [
        "XafRagEFCoreDbContext owns the XAF entities",
        "RagDbContext owns knowledge_chunks, created by an EF migration",
        "Cascade FKs are added at database level, not in either model"
      ]
    }
  ]
